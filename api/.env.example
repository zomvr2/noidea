# Copiar a api/.env.local (desarrollo) y definir las mismas variables en el proyecto de Vercel.
# Nunca subir la clave secreta al repositorio ni ponerla en la app.

SUPABASE_URL=https://<ref>.supabase.co
# Clave secreta (sb_secret_...) o service_role legacy. Solo servidor.
SUPABASE_SECRET_KEY=

# Solo para scripts locales:
# URL de la API (local: http://localhost:3000, producción: https://<proyecto>.vercel.app)
API_URL=http://localhost:3000
# Simulador de dispositivo: id y secreto de la tabla devices (select id, secret from devices;)
SIM_DEVICE_ID=
SIM_DEVICE_SECRET=
# Clave pública (sb_publishable_...) para que el simulador escuche Realtime como lo hará el ESP32
SUPABASE_PUBLISHABLE_KEY=
