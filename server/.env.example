# Copiar a server/.env y ajustar.

# HTTP
HOST=0.0.0.0
PORT=3000

# Base de datos SQLite
DB_PATH=./data/noidea.db

# Hardware: serial | simulator
HARDWARE_MODE=simulator
# Vacío = autodetectar el Arduino. En Windows suele ser COM3, COM4...
SERIAL_PORT=

# Calibración inicial del estanque de prueba (la usa el seed; luego vive en la tabla tanks)
TANK_NAME=Estanque prototipo
# UID de la tarjeta/llavero del kit (hex, mayúsculas, sin separadores). Leerlo con la app.
TANK_NFC_UID=00000000
TANK_CAPACITY_L=8
TANK_EMPTY_DISTANCE_MM=250
TANK_FULL_DISTANCE_MM=60
TANK_CRITICAL_PERCENT=20
# Caudal por gravedad medido con jarro graduado (L/s). Ver docs/hardware.md
VALVE_FLOW_LPS=0.05
