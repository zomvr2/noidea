{
  "name": "noidea",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema inteligente de gestión y distribución de agua — prototipo",
  "workspaces": [
    "app",
    "api",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:app": "npm run start -w app",
    "simulate": "npm run simulate -w api",
    "typecheck": "npm run typecheck -w @noidea/shared -w api -w app",
    "test": "npm run test -w @noidea/shared -w api"
  },
  "engines": {
    "node": ">=24"
  }
}
