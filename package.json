{
  "name": "noidea",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema inteligente de gestión y distribución de agua — prototipo",
  "workspaces": [
    "app",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:app": "npm run start -w app",
    "typecheck": "npm run typecheck -w @noidea/shared -w server -w app",
    "test": "npm run test -w @noidea/shared -w server"
  },
  "engines": {
    "node": ">=24"
  }
}
